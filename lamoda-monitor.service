[Unit]
Description=Lamoda Monitor Bot - New Products Notifier
After=network.target

[Service]
Type=simple
User=YOUR_USERNAME
WorkingDirectory=/home/YOUR_USERNAME/Lamoda_bot
ExecStart=/home/YOUR_USERNAME/Lamoda_bot/venv/bin/python /home/YOUR_USERNAME/Lamoda_bot/lamoda_monitor_bot.py
Restart=always
RestartSec=10

# Логирование
StandardOutput=append:/home/YOUR_USERNAME/Lamoda_bot/bot_output.log
StandardError=append:/home/YOUR_USERNAME/Lamoda_bot/bot_error.log

[Install]
WantedBy=multi-user.target

